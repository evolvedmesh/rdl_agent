{
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"allowJs": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"types": ["bun"],
		"jsx": "react-jsx",
		"jsxImportSource": "@gpuix/react",
		"paths": {
			"@layout/core": ["./packages/core/src/index.ts"],
			"@layout/feedback": ["./packages/feedback/src/index.ts"],
			"@layout/mcp": ["./packages/mcp/src/index.ts"],
			"@layout/acp": ["./packages/acp/src/index.ts"],
			"@layout/server": ["./packages/server/src/index.ts"]
		}
	},
	"include": [
		"packages/**/*.ts",
		"packages/**/*.tsx",
		"apps/**/*.ts",
		"apps/**/*.tsx",
		"spikes/**/*.ts"
	]
}
